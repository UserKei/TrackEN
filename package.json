{
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "web": "pnpm --filter @en/web dev",
    "server": "pnpm --filter @en/server start:dev",
    "ai": "pnpm --filter @en/server start:dev ai",
    "all": "concurrently \"pnpm run web\" \"pnpm run server\" \"pnpm run ai\"",
    "lint:ox": "oxlint .",
    "type-check": "pnpm --filter @en/web type-check",
    "build:web": "pnpm --filter @en/web build",
    "build:server": "pnpm --filter @en/server build"
  },
  "dependencies": {
    "@types/md5": "^2.3.6",
    "concurrently": "^9.2.1",
    "dayjs": "^1.11.20",
    "md5": "^2.3.0"
  },
  "devDependencies": {
    "oxlint": "^1.71.0"
  }
}
