# Compose profile: dev, preprod, or prod.
COMPOSE_PROFILES=dev

# Images built by compose.
WEB_IMAGE=tracken-web:local
SERVER_IMAGE=tracken-server:local
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:8-alpine
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest

# Public host ports.
WEB_PORT=8080
SERVER_PORT=3000
AI_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Database.
POSTGRES_DB=tracken
POSTGRES_USER=tracken
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://tracken:change-me@postgres:5432/tracken
AI_DATABASE_URL=postgresql://tracken:change-me@postgres:5432/tracken

# Redis / BullMQ.
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO.
MINIO_ROOT_USER=tracken
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=0
MINIO_ACCESS_KEY=tracken
MINIO_SECRET_KEY=change-me-minio-password
MINIO_BUCKET=tracken-assets

# Application secrets and integrations. Replace outside local development.
SECRET_KEY=change-me-jwt-secret
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_SSL=0
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_NOTIFY_URL=http://localhost:3000
DEESEEK_API_KEY=
DEESEEK_API_MODEL=deepseek-chat
DEEPSEEK_REASONER_API_MODEL=deepseek-reasoner
BOCHA_SEARCH_URL=https://api.bochaai.com/v1/web-search
BOCHA_API_KEY=

# Next.js public values can be consumed by the migrated web app.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_AI_BASE_URL=http://localhost:3001/ai/v1
NEXT_PUBLIC_SOCKET_URL=ws://localhost:3000
NEXT_PUBLIC_UPLOAD_URL=http://localhost:9000
API_PROXY_ORIGIN=http://localhost:3000
AI_PROXY_ORIGIN=http://localhost:3001
